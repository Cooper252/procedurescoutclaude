# Copy to .env for local development. Never commit real credentials.
# Owner role: runs migrations.
DATABASE_URL=postgresql+psycopg://ps_owner:ps_owner_dev@localhost:5432/procedurescout
# Restricted API role: can read published prices only, never the fixture schema.
API_DATABASE_URL=postgresql+psycopg://ps_api:ps_api_dev@localhost:5432/procedurescout
# Database used by the test suite (dropped and rebuilt by migrations on every run).
TEST_DATABASE_URL=postgresql+psycopg://ps_owner:ps_owner_dev@localhost:5432/procedurescout_test
TEST_API_DATABASE_URL=postgresql+psycopg://ps_api:ps_api_dev@localhost:5432/procedurescout_test
# Name of the restricted role that migrations grant read access to.
PS_API_ROLE=ps_api
# Provider portal (D-050): role that writes provider pages, reviews and counts only.
PORTAL_DATABASE_URL=postgresql+psycopg://ps_portal:ps_portal_dev@localhost:5432/procedurescout
PORTAL_SECRET=change-me-to-a-long-random-value
SITE_URL=http://localhost:3000
# Development only: show sign-in/review links on screen (no email service yet).
PORTAL_DEV_LINKS=true
